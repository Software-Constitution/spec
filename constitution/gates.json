{
  "schema": "software-constitution.gates.v2",
  "gates": [
    {
      "rule": "RULE-1",
      "argv": [
        "node",
        "scripts/gates/constitutional-gate.mjs",
        "RULE-1"
      ],
      "probes": [
        {
          "kind": "json-set",
          "path": "implementation/registry.json",
          "pointer": "/concepts/1/concept_id",
          "value": "scct.conformance"
        }
      ]
    },
    {
      "rule": "RULE-2",
      "argv": [
        "node",
        "scripts/gates/constitutional-gate.mjs",
        "RULE-2"
      ],
      "probes": [
        {
          "kind": "json-append",
          "path": "constitution/deployment-scope.json",
          "pointer": "/deployments",
          "value": {
            "id": "undeclared-deployment"
          }
        }
      ]
    },
    {
      "rule": "RULE-3",
      "argv": [
        "node",
        "scripts/gates/constitutional-gate.mjs",
        "RULE-3"
      ],
      "probes": [
        {
          "kind": "append-text",
          "path": "kit/lib/gate-runner.mjs",
          "text": "\n// TODO: illegal production placeholder\n"
        }
      ]
    },
    {
      "rule": "RULE-4",
      "argv": [
        "node",
        "scripts/gates/constitutional-gate.mjs",
        "RULE-4"
      ],
      "probes": [
        {
          "kind": "json-set",
          "path": "constitution/event-registry.json",
          "pointer": "/events",
          "value": []
        }
      ]
    },
    {
      "rule": "RULE-5",
      "argv": [
        "node",
        "scripts/gates/constitutional-gate.mjs",
        "RULE-5"
      ],
      "probes": [
        {
          "kind": "replace-text",
          "path": "constitution/DEVIATIONS.md",
          "find": "## Active deviations\n\n_(none)_",
          "replace": "## Active deviations\n\n### Forbidden waiver"
        }
      ]
    },
    {
      "rule": "RULE-6",
      "argv": [
        "node",
        "scripts/gates/constitutional-gate.mjs",
        "RULE-6"
      ],
      "probes": [
        {
          "kind": "json-set",
          "path": "implementation/registry.json",
          "pointer": "/concepts/0/ssot_module",
          "value": "missing/canonical-module.mjs"
        }
      ]
    }
  ]
}
